# Copy values into your host's SECRET STORE (Railway/Render variables), never into git.
APP_MODE=simulation                # simulation | sandbox | live
DATABASE_URL=postgres://user:pass@host:5432/autocommerce
PORT=3000
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=                # long random string (required outside simulation)
PUBLIC_BASE_URL=                   # https://<your-app>.up.railway.app
WEBHOOK_SHARED_SECRET=             # random; used by /webhooks/orders?secret=

# Notifications (optional, any)
NOTIFY_WEBHOOK_URL=                # Slack/Discord/ntfy incoming-webhook URL
RESEND_API_KEY=
OWNER_EMAIL=
NOTIFY_FROM_EMAIL=

# Amazon SP-API (Seller Central Europe, self-authorised private app)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# eBay (developer.ebay.com keyset + user refresh token)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENV=sandbox
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_VERIFICATION_TOKEN=           # 32–80 chars, for Marketplace Account Deletion endpoint

# Market data
KEEPA_API_KEY=

# Supplier
BIGBUY_API_KEY=
BIGBUY_ENV=sandbox

# Optional: localised listing copy (grounded, validated)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
